# Rome Bridge — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL — same as Evolution API's DB, or separate)
DATABASE_URL="postgresql://rome_user:your_secure_password@localhost:5432/rome_db?schema=public"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Codemax API (Anthropic-compatible)
CODEMAX_API_URL=https://api.codematics.ai/v1
CODEMAX_API_KEY=sk-cp-your-key-here

# Evolution API base URL (used by Rome Bridge to send messages)
# This should point to your Evolution API instance on the VPS
EVOLUTION_API_URL=http://localhost:8080
